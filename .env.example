# =====================================================================
# HH Goa 2026 Task 2: Voice-Enabled RAG System Configuration
# =====================================================================

# --- Speech-to-Text (STT) Providers ---
# Pick either SARVAM or ELEVENLABS
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- LLM Providers ---
# Options: groq, gemini, sarvam, mock
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- System Latency & Caching Settings ---
LATENCY_TARGET_MS=200
ENABLE_SEMANTIC_CACHE=true
CACHE_SIZE=1000
VECTOR_TOP_K=3

# --- Server Settings ---
PORT=8000
HOST=0.0.0.0
DEBUG=false
